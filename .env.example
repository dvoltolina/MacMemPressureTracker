# Sample environment overrides for memory-pressure-monitor.
# Copy to ~/.config/memory-pressure-monitor/config.sh and edit.
# All keys are MPM_-prefixed and UPPER_SNAKE_CASE per CONSISTENCY.md.

# How often launchd invokes the sampler (seconds). Default: 30
# MPM_INTERVAL_SECONDS=30

# Cooldown before another red-zone notification fires (seconds). Default: 600
# MPM_RED_COOLDOWN_SECONDS=600

# Cooldown before another swap-in-use notification fires (seconds). Default: 900
# MPM_SWAP_COOLDOWN_SECONDS=900

# Swap usage threshold to consider "in use" (MiB). Default: 64
# MPM_SWAP_THRESHOLD_MIB=64

# Notification backend: "osascript" (default) or "terminal-notifier"
# MPM_NOTIFICATION_BACKEND=osascript

# Optional sound to play with the notification. macOS system sounds work.
# MPM_NOTIFICATION_SOUND=

# Log file path. Default: $HOME/Library/Logs/memory-pressure-monitor.log
# MPM_LOG_PATH=
